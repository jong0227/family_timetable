rules_version = '2';

// kids-allowance-48c8e 프로젝트의 Firestore 규칙 전체. Moneycraft와 가족 시간표가 같은 프로젝트를 쓴다.
// ⚠️ 이 파일을 배포하면 프로젝트 규칙이 통째로 바뀐다. Moneycraft 부분(families)을 지우거나 고치지 말 것.
// 배포: firebase deploy --only firestore:rules --project kids-allowance-48c8e  (docs/FIREBASE_SETUP.md)
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Moneycraft (son_allowance_app) — 2026-10-23 배포돼 있던 그대로 ──
    // 2026-10-23: 목록 조회(list) 차단 — 사용자 승인. 예전 read에는 list가 들어 있어 익명 로그인한 누구나
    // 모든 가족 코드와 용돈 데이터를 볼 수 있었다. Moneycraft(sync_service.dart)는 families/{코드} 문서를
    // get·snapshots·set으로만 쓰므로 영향 없음(코드 확인). 콘솔(프로젝트 소유자)은 규칙과 무관하게 다 보인다.
    match /families/{code} {
      allow get, write: if request.auth != null;
    }

    // ── 가족 시간표 (family_timetable) ──
    // 가족 코드(6자리)를 아는 로그인 사용자(익명 포함)만 그 가족 문서와 하위 컬렉션을 읽고 쓴다.
    // 가족 코드가 사실상의 비밀번호다(Moneycraft와 같은 수준). 공개 배포 전 강화: ROADMAP M4.
    match /timetable_families/{familyCode} {
      // get만 허용하고 list(컬렉션 조회)는 막는다. read에는 list가 포함돼서, 예전 규칙으로는 익명 로그인한
      // 누구나 timetable_families 전체를 조회해 모든 가족 코드·아이 정보를 볼 수 있었다(코드 점검 C1, 2026-10-23).
      // 앱은 코드로 가족 문서를 직접 열기만 하므로 list가 필요 없다.
      allow get, write: if request.auth != null;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null
          && collection in ['members', 'children', 'versions', 'revisions', 'comments'];
      }
    }
  }
}
